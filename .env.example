# Copiar este archivo como .env y completar con los datos de cada entorno.
# No subir el archivo .env al repositorio.

# Django
# En el servidor: DEBUG=False y una SECRET_KEY nueva. Para generarla:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=False
SECRET_KEY=
# Dominios o IP del servidor separados por coma (ej: sgr.laserena.cl,3.15.20.10)
ALLOWED_HOSTS=
# Direcciones completas con https:// (ej: https://sgr.laserena.cl)
CSRF_TRUSTED_ORIGINS=
# False solo mientras el servidor no tenga certificado HTTPS
USAR_HTTPS=True

# Base de datos
DB_ENGINE=django.db.backends.mysql
DB_NAME=municipalidad_db
DB_USER=usuario
DB_PASSWORD=contraseña
DB_HOST=localhost
DB_PORT=3306

# Correo (recuperación de contraseña mediante PHPMailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo@gmail.com
SMTP_PASSWORD=contraseña_de_aplicación_de_google
SMTP_FROM_NAME=Delegaciones Municipales
PHPMAILER_SCRIPT=/home/ec2-user/phpmailer/enviar_correo.php
